{
  "name": "@culiu/search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "index-definitions.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "gold:evaluate": "node --env-file-if-exists=../../infra/.env --import tsx src/cli/evaluate-gold-set.ts",
    "gold:validate": "node --import tsx src/cli/validate-gold-set.ts",
    "smart-gold:evaluate": "node --env-file-if-exists=../../infra/.env --import tsx src/cli/evaluate-smart-gold.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "node --env-file-if-exists=../../infra/.env node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "meilisearch": "0.60.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tsx": "4.23.1",
    "vitest": "4.1.10"
  }
}
