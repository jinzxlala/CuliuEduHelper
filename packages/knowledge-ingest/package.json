{
  "name": "@culiu/knowledge-ingest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "knowledge:validate": "node --env-file-if-exists=../../infra/.env --import tsx src/cli/validate-import-input.ts",
    "test": "vitest run",
    "test:integration": "node --env-file-if-exists=../../infra/.env node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@culiu/ai": "workspace:*",
    "@culiu/authorization": "workspace:*",
    "@culiu/database": "workspace:*",
    "@culiu/search": "workspace:*",
    "@culiu/storage": "workspace:*",
    "@culiu/tasks": "workspace:*",
    "mammoth": "1.12.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "jszip": "3.10.1",
    "tsx": "4.23.1",
    "vitest": "4.1.10"
  }
}
