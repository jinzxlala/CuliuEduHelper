{
  "name": "@culiu/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../infra/.env --import tsx src/cli/migrate.ts",
    "db:seed": "node --env-file-if-exists=../../infra/.env --import tsx src/cli/seed.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "node --env-file-if-exists=../../infra/.env node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/pg": "8.20.3",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.1",
    "vitest": "4.1.10"
  }
}
