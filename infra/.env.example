# Copy to .env or run the setup scripts to generate secure local values.
# Keep all real values out of Git.
MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=replace-with-a-random-secret-of-at-least-32-bytes
# Optional production hardening; issue scoped keys before enabling these values.
# MEILI_SEARCH_API_KEY=replace-with-a-server-side-search-key
# MEILI_ADMIN_API_KEY=replace-with-a-server-side-index-management-key
POSTGRES_DB=culiu_edu_helper
POSTGRES_USER=culiu
POSTGRES_PASSWORD=replace-with-a-random-secret-of-at-least-32-bytes
DATABASE_URL=postgresql://culiu:replace-with-a-random-secret@127.0.0.1:5432/culiu_edu_helper
KNOWLEDGE_DATABASE_URL=postgresql://culiu:replace-with-a-random-secret@127.0.0.1:5432/culiu_edu_helper
OPERATIONS_DATABASE_URL=postgresql://culiu:replace-with-a-random-secret@127.0.0.1:5432/culiu_edu_helper
DATABASE_POOL_MAX=10
NEXTAUTH_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
NEXTAUTH_URL=http://127.0.0.1:3000
KNOWLEDGE_NEXTAUTH_SECRET=replace-with-a-different-random-secret-of-at-least-32-bytes
KNOWLEDGE_NEXTAUTH_URL=http://127.0.0.1:3000
OPERATIONS_NEXTAUTH_SECRET=replace-with-another-random-secret-of-at-least-32-bytes
OPERATIONS_NEXTAUTH_URL=http://127.0.0.1:3001
REDIS_PASSWORD=replace-with-a-random-secret-of-at-least-32-bytes
REDIS_URL=redis://:replace-with-a-random-secret@127.0.0.1:6379
LOCAL_STORAGE_ROOT=D:/replace-with-an-absolute-path/.local-data/evidence
BACKUP_ROOT=D:/replace-with-an-absolute-path/.local-data/backups
BACKUP_ENCRYPTION_KEY=replace-with-a-random-secret-of-at-least-32-bytes
POSTGRES_CONTAINER_NAME=culiu-edu-helper-postgres
KNOWLEDGE_MANIFEST_PATH=D:/replace-with-an-absolute-path/knowledge/source-manifest.v1.json
KNOWLEDGE_ANALYSIS_ROOT=D:/replace-with-an-absolute-path/data_origin
KNOWLEDGE_TRANSCRIPT_2025_ROOT=D:/replace-with-an-absolute-path/2025
KNOWLEDGE_TRANSCRIPT_2026_ROOT=D:/replace-with-an-absolute-path/2026
WORKER_CONCURRENCY=1
PROFILE_MODEL_PROVIDER=deepseek
KNOWLEDGE_EXTRACTION_MODEL_PROVIDER=deepseek
# Set this to the exact deployed source commit so model runs remain reproducible.
CULIU_GIT_COMMIT_SHA=0000000000000000000000000000000000000000
# Optional: isolate development or test queues.
# CULIU_TASK_QUEUE_NAME=culiu-tasks
# Local development only. Production must provide a real frozen authorization context below.
NODE_ENV=development
KNOWLEDGE_ALLOW_REDACTED_FIXTURE_AUTH=false
# KNOWLEDGE_IMPORT_AUTHORIZATION_CONTEXT_ID=replace-with-an-active-context-uuid
# KNOWLEDGE_IMPORT_AUTHORIZATION_CONTEXT_HASH=replace-with-the-context-sha256
DEEPSEEK_API_KEY=replace-with-the-server-side-api-key
DEEPSEEK_PROFILE_MAX_TOKENS=8192
DEEPSEEK_PROFILE_TIMEOUT_MS=45000
