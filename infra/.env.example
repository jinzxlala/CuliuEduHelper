# Copy to .env or run the setup scripts to generate secure local values.
# Keep all real values out of Git.
MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=replace-with-a-random-secret-of-at-least-32-bytes
# Optional production hardening; issue scoped keys before enabling these values.
# MEILI_SEARCH_API_KEY=replace-with-a-server-side-search-key
# MEILI_ADMIN_API_KEY=replace-with-a-server-side-index-management-key
POSTGRES_DB=culiu_edu_helper
POSTGRES_USER=culiu
POSTGRES_PASSWORD=replace-with-a-random-secret-of-at-least-32-bytes
DATABASE_URL=postgresql://culiu:replace-with-a-random-secret@127.0.0.1:5432/culiu_edu_helper
DATABASE_POOL_MAX=10
REDIS_PASSWORD=replace-with-a-random-secret-of-at-least-32-bytes
REDIS_URL=redis://:replace-with-a-random-secret@127.0.0.1:6379
LOCAL_STORAGE_ROOT=D:/replace-with-an-absolute-path/.local-data/evidence
DEEPSEEK_API_KEY=replace-with-the-server-side-api-key
