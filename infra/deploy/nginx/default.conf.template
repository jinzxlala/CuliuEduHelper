limit_req_zone $binary_remote_addr zone=login_limit:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=120r/m;

upstream culiu_knowledge_web {
    server knowledge-web:3000;
    keepalive 32;
}

upstream culiu_operations_web {
    server operations-web:3000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${KNOWLEDGE_APP_DOMAIN} ${OPERATIONS_APP_DOMAIN};
    server_tokens off;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${KNOWLEDGE_APP_DOMAIN};
    server_tokens off;

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 21m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location = /api/auth/callback/credentials {
        limit_req zone=login_limit burst=5 nodelay;
        proxy_pass http://culiu_knowledge_web;
        include /etc/nginx/proxy_params;
    }

    # Reviewed knowledge publication rebuilds the complete atomic search indexes.
    # Keep this synchronous compatibility route above the generic API location.
    location = /api/knowledge/imports {
        limit_req zone=api_limit burst=40 nodelay;
        proxy_pass http://culiu_knowledge_web;
        include /etc/nginx/proxy_params;
        proxy_read_timeout 660s;
        proxy_send_timeout 660s;
    }

    location ^~ /api/ {
        limit_req zone=api_limit burst=40 nodelay;
        proxy_pass http://culiu_knowledge_web;
        include /etc/nginx/proxy_params;
    }

    location / {
        proxy_pass http://culiu_knowledge_web;
        include /etc/nginx/proxy_params;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${OPERATIONS_APP_DOMAIN};
    server_tokens off;

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 21m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location = /api/auth/callback/credentials {
        limit_req zone=login_limit burst=5 nodelay;
        proxy_pass http://culiu_operations_web;
        include /etc/nginx/proxy_params;
    }

    location ^~ /api/ {
        limit_req zone=api_limit burst=40 nodelay;
        proxy_pass http://culiu_operations_web;
        include /etc/nginx/proxy_params;
    }

    location / {
        proxy_pass http://culiu_operations_web;
        include /etc/nginx/proxy_params;
    }
}
