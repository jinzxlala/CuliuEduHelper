# Copy to .env.production on the server. Never commit real values.
KNOWLEDGE_APP_DOMAIN=knowledge.example.com
OPERATIONS_APP_DOMAIN=operations.example.com
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
TLS_CERT_HOST_PATH=/srv/culiu/secrets/fullchain.pem
TLS_KEY_HOST_PATH=/srv/culiu/secrets/privkey.pem

POSTGRES_DB=culiu_edu_helper
POSTGRES_USER=culiu
POSTGRES_PASSWORD=replace-with-a-random-secret-of-at-least-32-bytes
DATABASE_URL=postgresql://culiu:replace-with-a-url-encoded-secret@postgres:5432/culiu_edu_helper
KNOWLEDGE_DATABASE_URL=postgresql://culiu:replace-with-a-url-encoded-secret@postgres:5432/culiu_edu_helper
OPERATIONS_DATABASE_URL=postgresql://culiu:replace-with-a-url-encoded-secret@postgres:5432/culiu_edu_helper
DATABASE_POOL_MAX=10
POSTGRES_CONTAINER_NAME=culiu-edu-helper-postgres
POSTGRES_MAINTENANCE_PORT=15432

REDIS_PASSWORD=replace-with-a-random-secret-of-at-least-32-bytes
REDIS_URL=redis://:replace-with-a-url-encoded-secret@redis:6379

MEILI_MASTER_KEY=replace-with-a-random-secret-of-at-least-32-bytes
MEILI_HOST=http://meilisearch:7700
MEILI_MAINTENANCE_PORT=17700

KNOWLEDGE_NEXTAUTH_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
OPERATIONS_NEXTAUTH_SECRET=replace-with-a-different-random-secret-of-at-least-32-bytes
DEEPSEEK_API_KEY=replace-with-the-server-side-api-key
DEEPSEEK_PROFILE_MAX_TOKENS=8192
DEEPSEEK_PROFILE_TIMEOUT_MS=45000
PROFILE_MODEL_PROVIDER=deepseek
KNOWLEDGE_EXTRACTION_MODEL_PROVIDER=deepseek

WORKER_CONCURRENCY=1
CULIU_GIT_COMMIT_SHA=0000000000000000000000000000000000000000
CULIU_IMAGE_TAG=0000000000000000000000000000000000000000

LOCAL_STORAGE_HOST_PATH=/srv/culiu/data/evidence
BACKUP_HOST_PATH=/srv/culiu/backups
BACKUP_ENCRYPTION_KEY=replace-with-a-separate-random-secret-of-at-least-32-bytes
KNOWLEDGE_ANALYSIS_HOST_PATH=/srv/culiu/sources/data_origin
KNOWLEDGE_TRANSCRIPT_2025_HOST_PATH=/srv/culiu/sources/transcripts/2025
KNOWLEDGE_TRANSCRIPT_2026_HOST_PATH=/srv/culiu/sources/transcripts/2026
